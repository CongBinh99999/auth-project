# Tên biến phải khớp đúng với app/config/settings.py.
# pydantic-settings dùng extra="ignore", nên tên sai sẽ bị bỏ qua trong im lặng.

APP_ENV=development
APP_DEBUG=True

DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost:5432/auth_db

# Bắt buộc đổi khi APP_ENV khác development: app sẽ từ chối khởi động nếu
# đây là giá trị mẫu hoặc ngắn hơn 32 ký tự. Sinh bằng: openssl rand -hex 32
JWT_SECRET=change_this_to_a_secure_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Để trống thì mail không gửi đi đâu cả; register vẫn trả 201 và token
# xác thực vẫn được tạo, chỉ là không ai nhận được.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
